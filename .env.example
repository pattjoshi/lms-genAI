# Copy this file to .env (in the same folder) and fill in your keys:
#   PowerShell:  Copy-Item .env.example .env
# .env is in .gitignore — NEVER commit it or paste keys in chat.
# Both docker compose and the backend read this one file.
# (Docker only uses the POSTGRES_* and NEO4J_* values.)

# ---------- App ----------
# dev | test | production. Unset = production (safe default): no demo login, no error details, and the
# backend refuses to start with the default passwords below, AUTH_COOKIE_SECURE=false or a localhost origin.
APP_ENV=dev                       # "dev" shows technical error details in API responses
APP_TIMEZONE=Asia/Kolkata         # "today" for the daily budget starts at midnight in this zone
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Postgres (Docker) ----------
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=lms
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---------- Qdrant (Docker) ----------
QDRANT_URL=http://localhost:6333

# ---------- Neo4j (Docker) ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Neo4j needs at least 8 characters.
NEO4J_PASSWORD=lms_neo4j_password

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
# Optional: OpenAI-compatible endpoint (Azure, proxy, local server). Leave empty for api.openai.com
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Leave empty if you switch to a reasoning model that doesn't accept temperature.
OPENAI_TEMPERATURE=0.2
# USD per 1M tokens for the models above. Check https://openai.com/api/pricing
# and update these if you change model or prices change.
CHAT_PRICE_INPUT_PER_1M=0.15
CHAT_PRICE_OUTPUT_PER_1M=0.60
EMBEDDING_PRICE_PER_1M=0.02

# ---------- Error handling: retry, then stop ----------
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3                 # retries after the first try -> at most 4 calls
LLM_RETRY_BASE_DELAY_SECONDS=1    # waits 1s, 2s, 4s between tries
LLM_MAX_OUTPUT_TOKENS=500
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# ---------- Cost guard ----------
DAILY_BUDGET_USD=1.0              # app refuses LLM calls once today's spend reaches this
# Per person, so one account (or a script) can't use up the day for everyone. 0 = off.
AI_REQUESTS_PER_MINUTE=10         # chat messages + data questions per user per minute (HTTP 429 after that)
AI_REQUESTS_PER_DAY=200           # ...and per user per day
STUDENT_DAILY_BUDGET_USD=0.10     # AI spend per student per day; staff only have DAILY_BUDGET_USD

# ---------- Phase 1: upload pipeline ----------
MAX_UPLOAD_MB=10
CHUNK_SIZE=1000                   # characters per chunk (~250 tokens). Re-index after changing.
CHUNK_OVERLAP=150                 # characters shared by neighbouring chunks
EMBEDDING_DIM=1536                # must match OPENAI_EMBEDDING_MODEL (text-embedding-3-small = 1536)
EMBEDDING_BATCH_SIZE=64
QDRANT_COLLECTION=course_chunks

# ---------- Phase 1: RAG answering ----------
RAG_TOP_K=5                       # chunks retrieved per question
RAG_MIN_SCORE=0.25                # cosine similarity below this = "not relevant" (no LLM call)
RAG_MAX_OUTPUT_TOKENS=600

# ---------- Phase 2: better retrieval ----------
# Every step can be switched off (true/false) to measure it: uv run python -m app.evals.retrieval --compare
RAG_HYBRID=true                   # meaning (embeddings) + keyword (BM25) search, merged with RRF
RAG_RERANK=true                   # a local cross-encoder re-scores the candidates (CPU, ~80 MB download once)
RAG_REWRITE=true                  # follow-ups ("give an example") -> standalone question (1 small LLM call)
RAG_CORRECTIVE=true               # nothing relevant -> rephrase in textbook terms, search once more (1 small LLM call)
RAG_CANDIDATES=20                 # chunks fetched before reranking keeps the best RAG_TOP_K
RAG_RRF_K=60                      # RRF constant (60 is the usual default)
RAG_MIN_RERANK_SCORE=0.02         # reranker relevance (0-1) below this = "not relevant". Tune with the eval.
RAG_HISTORY_TURNS=3               # earlier questions of the same chat used for follow-ups
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ---------- Phase 3: concept graph ----------
CONCEPT_EXTRACTION=true           # after indexing, an LLM extracts concepts + prerequisites into Neo4j (drafts)
CONCEPT_MAX_SECTION_CHARS=6000    # longer sections are sent to the LLM in several parts
CONCEPT_MAX_OUTPUT_TOKENS=1500
CONCEPT_MERGE_THRESHOLD=0.90      # embedding similarity >= this = same concept (merged, name kept as alias)
CONCEPT_SUGGEST_THRESHOLD=0.80    # >= this = kept apart but flagged "possible duplicate" for the teacher
LEARNING_PATH_MIN_SIMILARITY=0.35 # "I don't understand X": weakest embedding match still offered
QUIZ_MAX_PASSAGES=8               # course passages sent to the LLM for one quiz (spread over the file)
QUIZ_PASSAGE_CHARS=1500           # each passage is cut to this length
QUIZ_MAX_QUESTIONS=10
QUIZ_MAX_OUTPUT_TOKENS=3000
ROUTE_MIN_SIMILARITY=0.45         # chat router: nearest example intent must be at least this similar...
ROUTE_MIN_MARGIN=0.04             # ...and this far ahead of the runner-up, else the LLM decides
ROUTE_MAX_OUTPUT_TOKENS=80
WEAK_TOPIC_SCORE=65               # quiz average below this = weak topic (the assistant remembers it)
KNOWN_TOPIC_SCORE=80              # quiz average at or above this = learning path step marked "you know this"
PRACTICE_QUESTIONS=3              # questions per "quiz me" in the chat

# ---------- MCP (Phase 4b) ----------
MCP_RATE_LIMIT_PER_MINUTE=30      # tool calls per token per minute; an MCP client can loop
MCP_AGENT_MAX_STEPS=4             # LLM calls the chat assistant may make for one message (tool-calling loop)
# MCP_NOTES_DIR=C:\Users\you\notes  # optional, dev only: the assistant can read this folder through the
                                  # official filesystem MCP server (needs Node: npx). Shared by all users!

# ---------- Tickets and knowledge base (Phase 5) ----------
FAQ_MIN_SIMILARITY=0.80           # a support answer is reused for a new question at least this similar
SIMILAR_TICKET_MIN=0.75           # "similar past tickets" shown to support
INSIGHTS_GROUP_SIMILARITY=0.80    # teacher insights: questions this similar are grouped together
TICKET_ON_NO_ANSWER=true          # a question the material can't answer opens a ticket for support
INSIGHTS_DAYS=30                  # how far back teacher insights look

# ---------- SQL agent (Phase 6) ----------
# The agent's queries run as this second Postgres user: SELECT only, and only the rows row-level security
# allows for the person asking. The backend creates it at startup (your POSTGRES_USER must be allowed to
# create roles, which the Docker one is). Change the password here; the backend keeps Postgres in step.
SQL_AGENT_DB_USER=lms_sql_reader
SQL_AGENT_DB_PASSWORD=lms_sql_reader_password
SQL_AGENT_MAX_ATTEMPTS=3          # SQL written per question: first try + self-corrections after an error
SQL_AGENT_MAX_ROWS=200            # rows fetched per query; the rest is cut off (the answer says so)
SQL_AGENT_TIMEOUT_MS=5000         # Postgres statement_timeout for the agent's queries
SQL_AGENT_ANSWER_ROWS=30          # rows the LLM sees to write the answer (the table shows them all)
SQL_AGENT_MAX_OUTPUT_TOKENS=700

# ---------- Guardrails and evaluation (Phase 7) ----------
GUARDRAILS=true                   # check chat messages for prompt injection and off-topic questions first
GUARD_ON_TOPIC_SIMILARITY=0.40    # at least this similar to a course topic = on topic, no LLM call; below it
                                  # a small classifier decides (rules for known injections always run first)
GUARD_MAX_OUTPUT_TOKENS=80
EVAL_JUDGE_MODEL=                 # model that grades answers in the eval; empty = OPENAI_CHAT_MODEL
EVAL_MAX_OUTPUT_TOKENS=700
EVAL_BETTER_MARGIN=0.02           # a score must move more than this to count as better or worse

# ---------- Sign-in (accounts, sessions, Google) ----------
# Log in with email + password or Google. The browser keeps a session id in an httpOnly cookie.
# First admin:  cd backend; uv run python -m app.accounts create-admin --email you@example.com --name "Your Name"
AUTH_SESSION_DAYS=7               # how long a login lasts
AUTH_COOKIE_SECURE=false          # true when the site runs on https (production)
AUTH_COOKIE_SAMESITE=lax          # lax: frontend and backend on the same site; none: different sites (needs https)
AUTH_SIGNUP_OPEN=true             # anyone can create a STUDENT account; other roles come from an admin
AUTH_MAX_FAILED_LOGINS=5          # wrong passwords for one email before it is locked...
AUTH_LOCKOUT_MINUTES=15           # ...for this long
AUTH_DEMO_LOGIN=true              # "pick a seeded user" on the login page. Only ever works with APP_ENV=dev
# Google sign-in: Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application,
# Authorized JavaScript origins: http://localhost:3000. Empty = no Google button.
GOOGLE_CLIENT_ID=

# ---------- Langfuse (tracing) ----------
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
