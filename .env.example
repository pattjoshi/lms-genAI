# Copy this file to .env (in the same folder) and fill in your keys:
#   PowerShell:  Copy-Item .env.example .env
# .env is in .gitignore — NEVER commit it or paste keys in chat.
# Both docker compose and the backend read this one file.
# (Docker only uses the POSTGRES_* and NEO4J_* values.)

# ---------- App ----------
APP_ENV=dev                       # "dev" shows technical error details in API responses
APP_TIMEZONE=Asia/Kolkata         # "today" for the daily budget starts at midnight in this zone
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Postgres (Docker) ----------
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=lms
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---------- Qdrant (Docker) ----------
QDRANT_URL=http://localhost:6333

# ---------- Neo4j (Docker) ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Neo4j needs at least 8 characters.
NEO4J_PASSWORD=lms_neo4j_password

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
# Optional: OpenAI-compatible endpoint (Azure, proxy, local server). Leave empty for api.openai.com
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Leave empty if you switch to a reasoning model that doesn't accept temperature.
OPENAI_TEMPERATURE=0.2
# USD per 1M tokens for the models above. Check https://openai.com/api/pricing
# and update these if you change model or prices change.
CHAT_PRICE_INPUT_PER_1M=0.15
CHAT_PRICE_OUTPUT_PER_1M=0.60
EMBEDDING_PRICE_PER_1M=0.02

# ---------- Error handling: retry, then stop ----------
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3                 # retries after the first try -> at most 4 calls
LLM_RETRY_BASE_DELAY_SECONDS=1    # waits 1s, 2s, 4s between tries
LLM_MAX_OUTPUT_TOKENS=500
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# ---------- Cost guard ----------
DAILY_BUDGET_USD=1.0              # app refuses LLM calls once today's spend reaches this

# ---------- Phase 1: upload pipeline ----------
MAX_UPLOAD_MB=10
CHUNK_SIZE=1000                   # characters per chunk (~250 tokens). Re-index after changing.
CHUNK_OVERLAP=150                 # characters shared by neighbouring chunks
EMBEDDING_DIM=1536                # must match OPENAI_EMBEDDING_MODEL (text-embedding-3-small = 1536)
EMBEDDING_BATCH_SIZE=64
QDRANT_COLLECTION=course_chunks

# ---------- Phase 1: RAG answering ----------
RAG_TOP_K=5                       # chunks retrieved per question
RAG_MIN_SCORE=0.25                # cosine similarity below this = "not relevant" (no LLM call)
RAG_MAX_OUTPUT_TOKENS=600

# ---------- Langfuse (tracing) ----------
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
